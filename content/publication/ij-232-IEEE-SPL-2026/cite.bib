issn = {1070-9908, 1558-2361},
doi = {10.1109/LSP.2026.3751508},
abstract = {Space-time-coding reconfigurable intelligent surfaces enable harmonic beamforming through periodic modulation of element-wise reflection coefficients. However, harmonic coupling induced by a shared low-bit coding sequence poses a nonconvex discrete synthesis problem. This letter proposes a twostage solver for quantization-constrained harmonic disentanglement. A projected-gradient stage first computes a continuous unit-modulus solution, which is subsequently refined via the alternating direction method of multipliers to enforce discrete phase constraints and suppress out-of-band leakage. Numerical results demonstrate accurate multi-harmonic synthesis for prescribed harmonic coefficients under low-resolution phase control, outperforming direct quantization and characterizing tradeoffs among phase resolution, synthesis accuracy, and spectral concentration.},
copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
